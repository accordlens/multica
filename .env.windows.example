# Copy to .env.pilot or .env.test; never commit the filled file.
# Generate independent 64-character random hex values for each stack.
JWT_SECRET=
POSTGRES_PASSWORD=
POSTGRES_USER=multica
POSTGRES_DB=multica
MULTICA_WINDOWS_API_PORT=8080
MULTICA_WINDOWS_WEB_PORT=3000
# Replace with the exact HTTPS endpoint from ACCO-54 before human login.
FRONTEND_ORIGIN=http://localhost:3000
MULTICA_APP_URL=http://localhost:3000
DO_NOT_TRACK=true
# ACCO-55 owns human signup/allow-list/mail; smoke needs no account.
ALLOW_SIGNUP=false
# Use local named uploads, not a shared remote bucket.
S3_BUCKET=
